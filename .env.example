# Copy to .env for local use. On Render, set these in the dashboard (Environment tab).

APP_NAME=PayGate

# REQUIRED. Long random text. It encrypts merchants' gateway keys, so DO NOT change it after going live.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public https URL of your deployment (Render sets RENDER_EXTERNAL_URL automatically, so this is optional there)
BASE_URL=http://localhost:8000

# Database. SQLite is fine for local testing. On Render use the Postgres connection string.
DATABASE_URL=sqlite:///./paygate.db

# Telegram bot (create one with @BotFather)
BOT_TOKEN=
BOT_USERNAME=

# Optional force-subscribe: users must join this channel first (add the bot as an ADMIN of the channel).
# Example: @payzuupdates   Leave empty to turn it off.
FSUB_CHANNEL=

# Your owner panel at /admin (approve merchants). Long random text. Leave empty to disable the panel.
ADMIN_TOKEN=

# Optional: TronGrid key (free at trongrid.io) gives higher limits for TRC20 detection
TRONGRID_API_KEY=
# BSC RPC for BEP20 detection (the public default works for light use)
BSC_RPC_URL=https://bsc-dataseed.binance.org

# 1 = anyone approved by you can go live. 0 = skip approval (only for your own testing)
REQUIRE_KYC=1

# Local testing only: 1 shows a fake-login form so you can try the dashboard without Telegram
DEV_LOGIN=0
# Local testing only: 1 lets webhooks go to localhost
ALLOW_PRIVATE_WEBHOOKS=0
